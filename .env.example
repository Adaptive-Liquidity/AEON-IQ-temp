# Core
DATABASE_URL=postgresql://memoryos:memoryos_secret@localhost:5432/memoryos
PORT=8080
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_PROVIDER=openai
# Process role: proxy serves /v1 and /api/v1 without background jobs; worker
# runs background jobs and exposes only /health and /metrics; all does both.
# Default when unset or empty: all.
MEMORYOS_ROLE=all

# Database pool
DB_MAX_CONNECTIONS=20
DB_ACQUIRE_TIMEOUT_SECS=5
DB_IDLE_TIMEOUT_SECS=300

# Keys and models
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BASE_URL=https://api.openai.com
EXTRACTOR_MODEL=gpt-4o-mini
EXTRACTOR_BASE_URL=https://api.openai.com

# Durable extraction outbox
EXTRACTION_OUTBOX_ENABLED=true
EXTRACTION_WORKER_POLL_SECS=1
EXTRACTION_MAX_ATTEMPTS=5
EXTRACTION_BACKOFF_BASE_SECS=2

# Retrieval tuning
RETRIEVAL_THRESHOLD=0.80
MEMORY_DECAY_RATE=0.0
IMPORTANCE_BOOST_FACTOR=0.0
IMPORTANCE_REFRESH_BOOST=0.05
GRAPH_RETRIEVAL_ENABLED=false
RETRIEVAL_LOG_QUERY_TEXT=false

# Data integrity
DEDUP_THRESHOLD=0.05
CONFLICT_DETECTION_ENABLED=false

# Management API security
MANAGEMENT_API_KEY=
# Local development only: allows docker compose quickstart without a management key.
# For production, set MANAGEMENT_API_KEY and change this to false.
ALLOW_UNAUTH_MANAGEMENT=true

# Agent tenancy (see docs/AGENT_IDENTITY_MIGRATION.md)
# Leave every variable below unset for single-tenant V1 behaviour: no agent is
# assigned a tenant, and nothing about request handling changes.
#
# LEGACY_MIGRATION_MODE selects how historical agents are given a tenant. There
# is no default — an unset mode assigns nothing, and multi-tenant mode cannot be
# enabled until one is chosen.
#   single_tenant  every existing agent maps to LEGACY_TENANT_ID
#   mapped         only agents named in the tenant map are assigned; the rest
#                  stay unmapped and are served to nobody
LEGACY_MIGRATION_MODE=
# Required by, and only by, LEGACY_MIGRATION_MODE=single_tenant.
LEGACY_TENANT_ID=
# Required by, and only by, LEGACY_MIGRATION_MODE=mapped. Set exactly one of
# these: inline JSON, or a path to a file holding the same JSON.
# Format: {"<external_agent_id>": "<tenant-uuid>", ...}
LEGACY_TENANT_MAP=
LEGACY_TENANT_MAP_FILE=
# Startup refuses when this is true and any of the following holds: no migration
# mode is set, the recorded migration does not match it, any agent is unmapped,
# or MANAGEMENT_API_KEY is still accepted.
MULTI_TENANT_ENABLED=false

# Request limits
MAX_BODY_BYTES=10485760

# Archival
# Each compaction cycle produces compressed L3 facts AND a 2-3 sentence
# narrative L3 memory (memory_type='narrative') tagged with the same
# archival_batch_id. Narrative work is best-effort and only happens on this
# background path — the retrieval hot-path is never blocked.
ARCHIVAL_INTERVAL_HOURS=24
ARCHIVAL_MIN_AGE_DAYS=7
ARCHIVAL_MIN_MEMORIES=10

# HNSW maintenance
HNSW_MAINTENANCE_ENABLED=true
HNSW_MAINTENANCE_INTERVAL_HOURS=168
HNSW_MAINTENANCE_REINDEX_ENABLED=true
HNSW_MAINTENANCE_VACUUM_ENABLED=true
HNSW_MAINTENANCE_VACUUM_ANALYZE=true
HNSW_MAINTENANCE_ADVISORY_LOCK_ID=173456781234
HNSW_MAINTENANCE_WORK_MEM=2GB

# Proxy rate limiting
RATE_LIMIT_RPM=0
RATE_LIMIT_BURST=20

# Adaptive systems
AMP_ENABLED=false
RMK_ENABLED=false
